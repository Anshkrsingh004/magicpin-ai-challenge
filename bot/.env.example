# Copy to .env and fill in. The bot reads these at startup.

# LLM provider for the composer. Supported: groq, openai, gemini, deepseek, openrouter, ollama
LLM_PROVIDER=groq

# Your API key (Groq). Leave empty to run the bot in keyless template-fallback mode.
LLM_API_KEY=

# Composer model. For Groq, a strong current default is llama-3.3-70b-versatile.
# Others: openai/gpt-oss-120b, moonshotai/kimi-k2-instruct, qwen/qwen3-32b
LLM_MODEL=llama-3.3-70b-versatile

# Ollama only
OLLAMA_URL=http://localhost:11434

# --- Bot identity (surfaced on /v1/metadata) ---
TEAM_NAME=Vera Reforged
TEAM_MEMBERS=Ansh
CONTACT_EMAIL=anshkrsingh004@gmail.com
BOT_VERSION=1.0.0
